{
  "services": {
    "frontend": { "root": "client/", "framework": "vite" },
    "backend": { "root": "server/", "framework": "express" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
